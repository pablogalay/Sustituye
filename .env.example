JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=admin123

# Configuración SMTP de Gmail
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Only needed to run the EducaMadrid sync service (see sync/README.md)
EDUCAMADRID_USERNAME=
EDUCAMADRID_PASSWORD=
EDUCAMADRID_SURVEY_URL=
EDUCAMADRID_SURVEY_ID=
APP_API_URL=http://localhost:8000
# Shared secret between the api and sync containers so only the app can trigger a sync run
SYNC_TRIGGER_TOKEN=replace-with-a-long-random-secret
